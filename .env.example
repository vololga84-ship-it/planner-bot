TELEGRAM_TOKEN=ваш_токен_от_BotFather
GROQ_API_KEY=ваш_ключ_groq
SPREADSHEET_ID=id_вашей_google_таблицы
GOOGLE_CREDENTIALS_JSON={"type":"service_account",...}
# Telegram ID:Имя_в_планере[:Обращение_к_ней_самой] — третье поле нужно,
# только если владелец хочет, чтобы бот называл её иначе, чем зовут
# остальные участники (например, дочери зовут "Мама", бот к ней — "Лена")
USERS=123456789:Оля,987654321:Мама:Лена
# Владелец:ссылка_на_персональный_дашборд — необязательно, без записи
# для владельца кнопка дашборда просто не показывается
DASHBOARD_URLS=Оля:https://...,Мама:https://...
